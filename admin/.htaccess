# =========================================================
# ADMIN PANEL .htaccess
# =========================================================

RewriteEngine On

# Disable directory listing
Options -Indexes


# ---------------------------------------------------------
# Block hidden files
# ---------------------------------------------------------

<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# ---------------------------------------------------------
# Protect sensitive configuration files
# ---------------------------------------------------------

<FilesMatch "^(db|crypto|config)\.php$">
    Require all denied
</FilesMatch>


# ---------------------------------------------------------
# Block backup / temporary files
# ---------------------------------------------------------

<FilesMatch "\.(bak|backup|old|orig|save|swp|sql|log|ini)$">
    Require all denied
</FilesMatch>


# ---------------------------------------------------------
# Security headers
# ---------------------------------------------------------

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"

    Header always set X-Frame-Options "SAMEORIGIN"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

</IfModule>


# ---------------------------------------------------------
# Disable Apache server signature
# ---------------------------------------------------------

ServerSignature Off